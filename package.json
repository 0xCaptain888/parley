    "test:browser": "node scripts/browser-test.mjs",
    "test:demo": "node scripts/check-demo.mjs",
    "check:static": "node scripts/static-check.mjs",
    "check:slither": "node scripts/scan.mjs",
    "check:security": "node scripts/security-review.mjs",
    "check:boundaries": "node scripts/security-boundaries.mjs",
